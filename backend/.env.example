# Cross-country API keys (optional — sources stay "Henüz eklenmedi" without them)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_LIMIT=200
ADZUNA_MAX_JOBS=80

JOOBLE_API_KEY=
JOOBLE_MARKETS=DE
JOOBLE_DAILY_LIMIT=120
JOOBLE_MAX_JOBS=80

CAREERJET_API_KEY=
CAREERJET_USER_IP=127.0.0.1
CAREERJET_USER_AGENT=GermanyJobHunter/1.0
CAREERJET_DAILY_LIMIT=120
CAREERJET_MAX_JOBS=80

# France Travail (Pôle Emploi) partenaire OAuth
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_DAILY_LIMIT=200
FRANCE_TRAVAIL_MAX_JOBS=80

# Existing source knobs
ARBEITNOW_MAX_PAGES=2
ARBEITNOW_MAX_JOBS=80
SOURCE_FETCH_TIMEOUT_SECONDS=90
JOBICY_MAX_JOBS=40
REMOTIVE_MAX_JOBS=40

# Local Ollama (optional). If down, CV/Anschreiben stay rule-based.
OLLAMA_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
